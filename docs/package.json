    "shiki": "shiki-codegen --langs markdown,jinja,toml,shellscript,bash,sh,shell,zsh,html --themes rose-pine,rose-pine-dawn --engine javascript src/js/shiki.bundle.ts"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.16",
    "@tailwindcss/typography": "^0.5.19",
    "shiki-codegen": "^4.5.0",
    "tailwindcss": "^4.1.16"
  }
}
